{
  "name": "roseram-grok-bot",
  "version": "0.2.0",
  "private": false,
  "description": "Roseram Grok Bot Roseram app and API client",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/workspace-server.mjs",
    "help": "node src/index.mjs --help",
    "check": "node --check src/index.mjs && node --check src/terminal.mjs && node --check src/terminal-profile.mjs && node --check src/roseram-api.mjs",
    "terminal": "node src/terminal.mjs",
    "legacy": "node src/index.mjs",
    "build": "node scripts/build-workspace.mjs",
    "test": "node --test src/workspace-core.test.mjs src/workspace-server.test.mjs desktop/project-files.test.cjs desktop/developer-native.test.cjs",
    "desktop:windows": "npm --prefix desktop run build:windows"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
